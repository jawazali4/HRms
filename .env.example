# ============================================================
# HRMS environment settings (copy this file to ".env" if you
# run the system on your own computer. For Netlify, you enter
# the same values in Netlify's dashboard instead of here.)
# ============================================================

# --- Company details (shown on pay slips and in emails) -------
COMPANY_NAME="Al Noor Trading Company"
COMPANY_EMAIL=noreply@example.com

# --- Port used when you run the API on your own computer ------
PORT=4000

# --- Database -------------------------------------------------
# Leave DATABASE_URL empty to use the built-in local file database
# (backend/data/hrms.sqlite). It works with ZERO setup.
#
# For a shared cloud database (recommended for Netlify) use a free
# Supabase project. In Supabase click "Connect" and copy the
# "Session pooler" URI (host ...pooler.supabase.com). Do NOT use the
# "Direct connection" (db.xxxx.supabase.co) - it is IPv6-only and
# Netlify cannot reach it.
DATABASE_URL=

# --- Security -------------------------------------------------
# Create your own long random secret. Example generator:
# https://passwordsgenerator.net  (or run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-this-to-a-long-random-secret-string

# --- Email (automatic pay-slip emails) ------------------------
# Optional. If left empty, pay slips are still generated, shown in
# the dashboard, and downloadable as PDF — the "email" feature is
# simply marked as disabled instead of failing.
# Free option: a Gmail account with an "App Password".
#   https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# --- Used by Netlify only -------------------------------------
# Leave as-is.
NODE_ENV=development
